NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/pdf-book-store
MONGO_DB_NAME=pdf-book-store
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=7d
SEED_ADMIN_FROM_ENV=false
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_NOTIFY_EMAIL=owner@example.com
OWNER_ADMIN_EMAIL=owner@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="PDF Book Store <yourgmail@gmail.com>"
# For Gmail, SMTP_PASS must be a Google App Password, not your normal Gmail password.
FAST2SMS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=PDF Book Store
UPLOAD_DIR=uploads
